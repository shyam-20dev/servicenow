# ---------------------------------------------------------------
# SmartDesk AI configuration. Copy this file to ".env" and edit.
# NEVER commit .env or share your keys.
# Everything is optional: with no keys the app runs in clearly
# labelled fallback mode (rule-based triage + keyword retrieval).
# ---------------------------------------------------------------

# ---- LLM: any OpenAI-compatible Chat Completions API ----
# OpenAI:      https://api.openai.com/v1                                   model e.g. gpt-4o-mini
# Groq:        https://api.groq.com/openai/v1                              model e.g. llama-3.1-8b-instant
# Gemini:      https://generativelanguage.googleapis.com/v1beta/openai     model e.g. gemini-2.0-flash
# OpenRouter:  https://openrouter.ai/api/v1
# Ollama:      http://localhost:11434/v1   (set any non-empty key, e.g. ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Embeddings (for semantic RAG search) ----
# Defaults to the same base URL and key as the LLM above.
# Set these only if your embedding provider differs
# (e.g. Groq has no embeddings API -> use OpenAI/Gemini/Ollama for embeddings).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# OpenAI: text-embedding-3-small | Gemini: text-embedding-004 | Ollama: nomic-embed-text
EMBEDDING_MODEL=text-embedding-3-small
# Minimum cosine similarity for a chunk to count as relevant (tune per model)
EMBEDDING_MIN_SCORE=0.30

# ---- ServiceNow (optional) ----
# Example: https://dev123456.service-now.com   (no trailing slash)
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# ---- App ----
RATE_LIMIT_PER_MINUTE=60
