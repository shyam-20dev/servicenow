# --- ServiceNow ---
# mock = simulated incidents (no ServiceNow needed); live = real instance via REST
SN_MODE=mock
SN_INSTANCE=https://YOUR-INSTANCE.service-now.com
SN_USER=your-integration-user
SN_PASSWORD=change-me

# --- Ollama (local LLM) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Ports ---
BACKEND_PORT=8010
FRONTEND_PORT=3000
