# --- ServiceNow ---
# mock = simulated incidents (no ServiceNow needed); live = real instance via REST
SN_MODE=mock
SN_INSTANCE=https://YOUR-INSTANCE.service-now.com
SN_USER=your-integration-user
SN_PASSWORD=change-me

# --- LLM provider: "ollama" (local model) or "gemini" (Google API) ---
LLM_PROVIDER=ollama

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Gemini (used when LLM_PROVIDER=gemini). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMS=768

# Optional tuning (embedding models score similarity differently)
# KB_MIN_SCORE=0.58        # ollama default; gemini default is 0.60
# KB_REL_MARGIN=0.15
# CLUSTER_THRESHOLD=0.70   # ollama default; gemini default is 0.85

# --- Ports ---
BACKEND_PORT=8010
FRONTEND_PORT=3000
